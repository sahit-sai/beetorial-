# ====================================================================
# Beetorial Environment Configuration
# ====================================================================

# Supabase Auth & Database (Required for live mode; leave empty for verified local sandbox)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Note: NEVER expose Supabase service_role key to client.
# SUPABASE_SERVICE_ROLE_KEY= (server / edge function only)

# Payment Provider Configuration (Optional - Razorpay or Stripe)
# When left empty, payment module operates in strictly labeled Demo Sandbox mode
VITE_PAYMENT_PROVIDER=
VITE_PAYMENT_KEY_ID=

# Video Conferencing Provider (Optional - Google Meet, Zoom, Jitsi)
# When left empty, video sessions require explicit provider link configuration
VITE_DEFAULT_VIDEO_PROVIDER=google_meet
